{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "types": ["node", "vscode"],
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"]
}
